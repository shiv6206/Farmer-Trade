PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5510
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_DEV_MODE=true

# Local MongoDB for bid history. Production must use a managed MongoDB URI
# with an explicit database name and restricted credentials.
MONGO_URI=mongodb://127.0.0.1:27017/farmer_trade

# Local SQLite for development only. Production must use a remote Turso URL.
TURSO_DATABASE_URL=file:./local.db
# TURSO_AUTH_TOKEN=