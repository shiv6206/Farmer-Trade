PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5510
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string.
# Replace the username, password, cluster host, and database name.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/farmer_trade?retryWrites=true&w=majority

# Leave these unset to use the local SQLite database in development.
TURSO_DATABASE_URL=file:./local.db
# TURSO_AUTH_TOKEN=